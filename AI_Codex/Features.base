filters:
  and:
    - file.inFolder("Features")
    - file.ext == "md"
formulas:
  age_days: (now() - file.ctime).days
  has_meta: if(type, "ok", "no frontmatter")
properties:
  ticket:
    displayName: "#"
  formula.age_days:
    displayName: Age (d)
  formula.has_meta:
    displayName: Meta
views:
  - type: table
    name: Features
    groupBy:
      property: area
      direction: ASC
    order:
      - file.name
      - ticket
      - type
      - area
      - stack
      - tags
      - formula.age_days
  - type: table
    name: Needs metadata
    filters:
      not:
        - type
    order:
      - file.name
      - file.mtime
