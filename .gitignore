# Runtime state is never part of source control — the package ships only schema and lifecycle rules.
.orchestration-qc/

# Generated release and evaluation outputs
dist/
orchestration-quality-control-workspace/

# Local Obsidian editor state
AI_Codex/.obsidian/

# The contributor ledger is part of this repository. A user-global
# gitignore may list `AI_Codex/`; un-ignore the tree so it stays tracked.
!AI_Codex/
!AI_Codex/**

# Python bytecode cache
__pycache__/
*.pyc

# The user global gitignore excludes **/.claude/ and **/.cursor/, but this
# repo ships its skills, agents and adapters there. Re-include them so new
# files are tracked normally instead of needing git add -f.
!.claude/
!.cursor/
*.local.json
.claude/settings.local.json
