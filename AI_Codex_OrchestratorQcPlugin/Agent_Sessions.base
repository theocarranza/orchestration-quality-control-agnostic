filters:
  and:
    - file.inFolder("Agent_Sessions")
    - file.ext == "md"
formulas:
  age_days: (now() - file.ctime).days
  has_meta: if(type, "ok", "no frontmatter")
properties:
  formula.age_days:
    displayName: Age (d)
  formula.has_meta:
    displayName: Meta
views:
  - type: table
    name: Sessions
    order:
      - file.name
      - date
      - type
      - ticket
      - tags
      - formula.age_days
  - type: table
    name: Needs metadata
    filters:
      not:
        - type
    order:
      - file.name
      - file.mtime
