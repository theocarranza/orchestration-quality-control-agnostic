{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orchestration-quality-control/schemas/upgrade-proposal.schema.json",
  "title": "Atomic orchestration upgrade proposal",
  "type": "object",
  "required": ["actions"],
  "additionalProperties": false,
  "properties": {
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["action", "path", "content", "rationale", "trace_ids"],
        "additionalProperties": false,
        "properties": {
          "action": { "enum": ["create", "update"] },
          "path": { "type": "string", "minLength": 1 },
          "content": { "type": "string" },
          "source_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
          "rationale": { "type": "string", "minLength": 1 },
          "trace_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
