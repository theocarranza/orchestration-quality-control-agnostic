{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orchestration-quality-control/schemas/structure-manifest.schema.json",
  "title": "Frozen orchestration structure manifest",
  "type": "object",
  "required": ["schema_version", "mechanism_path", "candidate_count", "total_bytes", "candidates"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "mechanism_path": { "type": "string" },
    "candidate_count": { "type": "integer", "minimum": 1 },
    "total_bytes": { "type": "integer", "minimum": 0 },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "size", "roles", "evidence"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size": { "type": "integer", "minimum": 0 },
          "roles": { "type": "array", "items": { "type": "string" } },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
