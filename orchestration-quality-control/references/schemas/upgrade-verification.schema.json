{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orchestration-quality-control/schemas/upgrade-verification.schema.json",
  "title": "Post-apply upgrade verification",
  "type": "object",
  "required": ["schema_version", "run_id", "status", "findings", "template_gaps", "report", "verified_at"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string" },
    "status": { "enum": ["all_passed", "failed"] },
    "findings": { "type": "array" },
    "template_gaps": { "type": "array" },
    "report": { "type": "string" },
    "verified_at": { "type": "string" }
  }
}
