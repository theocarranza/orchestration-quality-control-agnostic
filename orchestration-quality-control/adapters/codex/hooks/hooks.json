{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/oqc_codex_guard.py\"",
            "timeout": 5,
            "statusMessage": "Checking orchestration QC approval"
          }
        ]
      }
    ]
  }
}
